# Docker build 排除清单 — 让镜像构建更快、上下文更小
# 注意：这是 ROOT 的 .dockerignore，对所有 Dockerfile 生效。
# frontend Dockerfile 的 context 是子目录，根级排除对它不影响。

# Git
.git/
.gitignore
.gitattributes

# 文档
*.md
CHANGELOG.md
docs/

# 本地数据 / 日志（容器内会重新挂卷）
data/
*.log
*.sqlite
*.db

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyo
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# 虚拟环境
.venv/
venv/
env/

# Node — 前端 Dockerfile 的 context 是子目录，但保险起见
node_modules/
.npm/

# 前端构建产物 / IDE
dist/
build/
.vscode/
.idea/
*.swp

# 环境变量 — 不进镜像，必须用 env_file
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Windows 批处理 — 容器里不用
*.bat
