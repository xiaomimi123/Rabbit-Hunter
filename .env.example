# Rabbit Hunter — 环境变量模板
#
# 用法：cp .env.example .env，然后按需填写。
# docker-compose 会自动读取根目录的 .env 注入到 api + collector 容器。
#
# 字段分组：
#   ① 必填   — 跑通最小集
#   ② AI     — 想用 OpenAI 决策层时填
#   ③ 安全   — 想暴露到 LAN 时填
#   ④ 风控   — 调风险参数
#   ⑤ 行为   — fail-open 旋钮（默认全部安全）

# ═══════════════════════════════════════════════════════════════════
# ① 最小集
# ═══════════════════════════════════════════════════════════════════

# 信号源/市场数据交易所（v0.5.2 起默认 OKX；改 binance 切回去）
# OKX 公开行情不需要 key；带 key 仅提升 rate limit
EXCHANGE=okx

# OKX API（v0.5.2 起的默认信号源）
# 公开行情可以不填；私有端点（持仓/下单）必须填，且必须额外提供 PASSPHRASE
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_TESTNET=false

# Binance API（备用；EXCHANGE=binance 时使用）
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# 宪法 §5 要求 3-5x 起步；v5_risk_calculator.derive_safe_leverage 会按 SL 距离再往下压
BINANCE_LEVERAGE=5

# Supabase（v4.3 历史选项，已弃用；主库改用 data/rabbit_hunter.db SQLite）
# 留空即可。除非确认要把历史日志镜像到 PostgreSQL，否则不需要填。
SUPABASE_URL=
SUPABASE_KEY=

# 启用自动交易（默认 false = 影子模式）
ENABLE_AUTO_TRADING=false

# ═══════════════════════════════════════════════════════════════════
# ② AI 决策层
# ═══════════════════════════════════════════════════════════════════

# OpenAI Assistants API — 不配 key 时 AI 层不启用
OPENAI_API_KEY=
OPENAI_AI_ENABLED=true
OPENAI_TRADING_MODEL=gpt-4o
OPENAI_DECISION_TIMEOUT=20
# 首次跑 setup_assistant.py 拿到这两个 ID 后填回
OPENAI_ASSISTANT_ID=
OPENAI_VECTOR_STORE_ID=

# DeepSeek（可选辅助打分器）— 默认关
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# ③ 安全
# ═══════════════════════════════════════════════════════════════════

# 远程访问开启鉴权 — 留空表示本机模式，require_auth 不强制
# 强烈建议生成方式： openssl rand -hex 32
# 前端的 VITE_API_TOKEN 必须与本值一致（docker-compose 已经自动同步）
API_BEARER_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# ④ 风控
# ═══════════════════════════════════════════════════════════════════

V43_ENABLED=true
# 宪法 §5 tier 0：单笔最大风险 1%。资格层 (scripts/risk_constitution.EQUITY_TIERS)
# 在本金 > 50k 时自动解锁到 1.5%。env 在此为软上限，scorer 取 min(宪法, env)。
V43_RISK_PER_TRADE=0.01
V43_TRADE_THRESHOLD=0.6
V44_ENABLED=false
V44_POSITION_SIZE_MULTIPLIER=1.0

# SHORT 路径 — 默认禁用（chandelier/funding/router 修复已合并，但仍建议测试网先开）
ENABLE_SHORT_TRADING=false

# binance_position_sync blip 保护
BINANCE_SYNC_REQUIRED_MISSES=2
BINANCE_SYNC_GRACE_SECONDS=60
BINANCE_SYNC_BLIP_MIN_POSITIONS=2

# MarketScanner 最低 24h 成交额(USDT)。过低会让 PEPE/PUMP 这类微价 meme 霸榜,
# 过高会漏掉新上线中盘。30M = 平衡点;想只盯主流(SOL/AVAX/LINK 级别)用 100M。
MIN_VOLUME_24H_USDT=30000000

# V4.3 波动率最低预期收益(基于 ATR×phase 倍数计算)。低于这个值 → LOW_EXPECTED_RETURN_ATR 拦截。
# 留空走默认:SHADOW 模式 1%(让纸面交易能积累样本验证策略),LIVE 模式 2%(避免低波动期被手续费吃掉)。
# 想强制统一阈值就显式填,例如 MIN_EXPECTED_MOVE_PCT=0.015
MIN_EXPECTED_MOVE_PCT=

# ═══════════════════════════════════════════════════════════════════
# ⑤ 行为旋钮（fail-closed by default — 不推荐改）
# ═══════════════════════════════════════════════════════════════════

# AI 不可用时是否仍下单（默认 false = 跳过交易）
AI_FAIL_OPEN=false
# SL/TP 挂单失败是否保留刚开的仓位（默认 false = 立即平仓回滚）
SL_TP_FAIL_OPEN=false

# 本地 LR AI Judge — 已 deprecated，模型未训练时输出噪声
AI_JUDGE_ENABLED=false
